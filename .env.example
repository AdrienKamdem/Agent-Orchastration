# Copy to .env and fill in. .env is git-ignored.

# Postgres + pgvector (matches docker-compose.yml)
DATABASE_URL=postgresql://copilot:copilot@localhost:5432/copilot

# Where raw/parsed files and the PDF inbox live
DATA_DIR=data

# REQUIRED for EDGAR: SEC fair-access policy wants a name and contact email.
SEC_USER_AGENT="Your Name your.email@example.com"

# Embeddings: "sentence-transformers" (real model, needs `uv sync --extra embeddings`)
# or "hashing" (no dependencies, word overlap only; fine for a first smoke test).
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Chunking: section_aware | recursive
CHUNKER=section_aware
CHUNK_MAX_TOKENS=400
CHUNK_OVERLAP_TOKENS=50

LOG_LEVEL=INFO
LOG_JSON=false
